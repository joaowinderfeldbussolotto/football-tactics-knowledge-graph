# --- Provedor de LLM (trocar só isso para mudar de provedor) ---
# LLM_PROVIDER: mistral | anthropic | gemini | openrouter
LLM_PROVIDER=mistral
LLM_API_KEY=
# LLM_MODEL: ex. mistral-large-latest | claude-sonnet-5 | gemini-2.0-flash |
# stealth/ox-alpha (OpenRouter exige o prefixo do laboratório: "vendor/modelo")
LLM_MODEL=
# LLM_SMALL_MODEL: usado nas etapas internas do Graphiti (camada 3)
LLM_SMALL_MODEL=
# LLM_MAX_RETRIES: repassado ao construtor de TODOS os SDKs (Anthropic/OpenAI-compat:
# max_retries; google-genai: HttpRetryOptions; mistralai: RetryConfig). Os SDKs
# respeitam Retry-After/retryDelay do servidor — não há camada própria de retry
# (ADR-7 em docs/05-decisoes.md). Em chaves free-tier, suba para 6-8.
LLM_MAX_RETRIES=5
# LLM_STRUCTURED_OUTPUT_MODE: json_schema | json_object. Só importa para
# provedores compatíveis com OpenAI (mistral, openrouter): nem todo modelo
# servido por agregador implementa o modo estrito json_schema — troque para
# json_object se a camada 3 falhar em validação de saída num modelo novo.
LLM_STRUCTURED_OUTPUT_MODE=json_schema
# Teto de tokens de SAÍDA por chamada de /ask e /report. Em modelo de raciocínio o
# raciocínio oculto conta contra ele; se esgotar, a chamada falha com "Model token
# limit (N) exceeded before any response was generated".
LLM_MAX_TOKENS=16000
# Esforço de raciocínio (só openrouter): vazio | none | low | medium | high.
# Vazio = não envia nada. Opt-in: pode piorar uso de ferramenta/saída estruturada.
LLM_REASONING_EFFORT=

# --- Embeddings ---
# EMBEDDER_PROVIDER: mistral | gemini | (vazio = endpoint compatível com OpenAI)
# OpenRouter não serve embeddings — se LLM_PROVIDER=openrouter, configure aqui
# um provedor de embeddings à parte (ex. gemini).
EMBEDDER_PROVIDER=
EMBEDDER_API_KEY=
# EMBEDDER_MODEL: ex. mistral-embed | gemini-embedding-001
EMBEDDER_MODEL=

# --- Concorrência (o "rate limiting" inteiro do projeto) ---
# lido nativamente pelo Graphiti; reaproveitado no semáforo do PydanticAI
SEMAPHORE_LIMIT=5
# GRAPHITI_PACE_SECONDS: espaçamento entre triplets na indexação do Graphiti
# (~3-4 embeddings por triplet). 2.0 cabe na cota free-tier do Gemini
# (100 embed-requests/min); com chave paga use 0.
GRAPHITI_PACE_SECONDS=2.0

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Langfuse (opcional; vazio desliga a instrumentação) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dados ---
# Partidas da Copa do Mundo 2022 com dados 360 no StatsBomb Open Data:
# 3869685 = Argentina x França (final), 3869519 = Argentina x Croácia (semi),
# 3869354 = Inglaterra x França (quartas)
STATSBOMB_MATCH_IDS=3869685,3869519,3869354
