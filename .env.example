# --- Provedor de LLM (trocar só isso para mudar de provedor) ---
# LLM_PROVIDER: mistral | anthropic | gemini | openrouter | bedrock
LLM_PROVIDER=mistral
LLM_API_KEY=
# LLM_MODEL: ex. mistral-large-latest | claude-sonnet-5 | gemini-2.0-flash |
# z-ai/glm-5.3-flash (OpenRouter exige o prefixo do laboratório: "vendor/modelo").
# O modelo precisa suportar tool calling e saída estruturada: confira com
# python scripts/smoke_llm.py antes do benchmark.
LLM_MODEL=
# LLM_MAX_RETRIES: repassado ao construtor de TODOS os SDKs (Anthropic/OpenAI-compat:
# max_retries; google-genai: HttpRetryOptions; mistralai: RetryConfig). Os SDKs
# respeitam Retry-After/retryDelay do servidor; não há camada própria de retry.
# Em chaves free-tier, suba para 6-8.
LLM_MAX_RETRIES=5
# Teto de tokens de SAÍDA por chamada ao LLM. Em modelo de raciocínio o
# raciocínio oculto conta contra ele; se esgotar, a chamada falha com "Model token
# limit (N) exceeded before any response was generated".
LLM_MAX_TOKENS=16000
# Esforço de raciocínio (openrouter e bedrock): vazio | none | low | medium | high. No Bedrock
# vira o raciocínio estendido do PydanticAI (`thinking`) e força temperatura 1.
# Vazio = não envia nada. Opt-in: pode piorar uso de ferramenta/saída estruturada.
LLM_REASONING_EFFORT=
# Provedor fixo no OpenRouter (só openrouter): slug da página do modelo, ex. baidu/fp8.
# Com valor, o pedido NÃO cai em outro provedor (allow_fallbacks=false). Vazio = o
# OpenRouter escolhe. Vários, separados por vírgula, são uma ordem de preferência.
LLM_PROVIDER_ORDER=
# Amazon Bedrock (LLM_PROVIDER=bedrock; precisa de: pip install -e ".[bedrock]"):
# LLM_MODEL = ID do modelo no Bedrock (ex. openai.gpt-oss-120b-1:0), LLM_API_KEY = chave de API
# do Bedrock (vazio = credenciais AWS padrão do ambiente), LLM_AWS_REGION = região (vazio =
# AWS_REGION do ambiente). LLM_PROMPT_CACHE=false tira o ponto de cache dos prompts, para
# modelo cujo Bedrock não oferece cache de prompt.
LLM_AWS_REGION=
LLM_PROMPT_CACHE=true

# --- Embeddings (usados só pelo braço "vector" do benchmark) ---
# EMBEDDER_PROVIDER: mistral | gemini | (vazio = endpoint compatível com OpenAI)
# OpenRouter não serve embeddings — se LLM_PROVIDER=openrouter, configure aqui
# um provedor de embeddings à parte (ex. gemini).
EMBEDDER_PROVIDER=
EMBEDDER_API_KEY=
# EMBEDDER_MODEL: ex. mistral-embed | gemini-embedding-001
EMBEDDER_MODEL=

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Langfuse (opcional; vazio desliga a instrumentação) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dados ---
# O benchmark usa só a final da Copa 2022: 3869685 = Argentina x França.
STATSBOMB_MATCH_IDS=3869685
