# --- Provedor de LLM (trocar só isso para mudar de provedor) ---
LLM_PROVIDER=anthropic          # anthropic | openai | gemini | openai_compatible
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_SMALL_MODEL=claude-haiku-4-5-20251001   # usado na extração de entidades (barato/rápido)
LLM_BASE_URL=                    # obrigatório apenas se LLM_PROVIDER=openai_compatible (DeepSeek, Together, OpenRouter, etc.)
LLM_MAX_RETRIES=5                # repassado direto ao construtor do cliente do SDK do provedor (ver seção 5.3, não é uma camada nossa)

# --- Embeddings ---
EMBEDDER_PROVIDER=openai         # openai | gemini
EMBEDDER_API_KEY=
EMBEDDER_MODEL=text-embedding-3-small

# --- Concorrência (único controle de "rate limit", reaproveitado em todo o projeto) ---
SEMAPHORE_LIMIT=5                # já é lido nativamente pelo Graphiti; reaproveitado também para as chamadas do PydanticAI

# --- Neo4j ---
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Langfuse ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# --- StatsBomb ---
STATSBOMB_MATCH_IDS=3869151,3869685   # exemplo: preencher com IDs reais de partidas com dados 360
STATSBOMB_REPLAY_SPEED=60             # multiplicador de velocidade do replay (60 = 1 min do jogo em 1s real)
